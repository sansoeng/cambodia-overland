{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambodia-overland-staging",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "staging.cambodiaoverlandtravel.com",
      "custom_domain": true
    }
  ]
}
